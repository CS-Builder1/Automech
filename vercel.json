{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/((?!assets/|favicon.svg|pwa-.*\\.png|manifest.webmanifest|sw.js|workbox-.*\\.js|registerSW.js).*)", "destination": "/index.html" }
  ]
}
