# Cloud sync (optional). Without these, Automech runs fully offline on-device.
# Create a Supabase project, run supabase/migrations/0001_init.sql, then set:
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Subscriptions & online card payments via PayPal (optional).
# Without these, Plans show a "checkout not connected" note and invoice PayPal
# falls back to manual recording. Create a PayPal app (client id) and two
# subscription plans in the PayPal dashboard, then set:
VITE_PAYPAL_CLIENT_ID=your-paypal-client-id
VITE_PAYPAL_CURRENCY=USD
VITE_PAYPAL_PLAN_PRO=P-xxxxxxxxxxxxxxxx
VITE_PAYPAL_PLAN_ENTERPRISE=P-xxxxxxxxxxxxxxxx
